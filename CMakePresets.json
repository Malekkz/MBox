{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "dev",
      "displayName": "Development (native, debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (native, optimised, hardened)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG",
        "SCADA_HARDENING": "ON"
      }
    },
    {
      "name": "perf",
      "displayName": "Performance tests (native, release flags, debug info)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SCADA_HARDENING": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "AddressSanitizer with leak detection + UndefinedBehaviorSanitizer (native, debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SCADA_SANITIZER": "address-undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer (native, debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SCADA_SANITIZER": "thread"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Fuzzing: libFuzzer + AddressSanitizer + UndefinedBehaviorSanitizer (native, Clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "SCADA_SANITIZER": "fuzz"
      }
    },
    {
      "name": "arm64",
      "hidden": true,
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake"
    },
    {
      "name": "dev-arm64",
      "displayName": "Development (cross-compiled for ARM64)",
      "inherits": [
        "dev",
        "arm64"
      ]
    },
    {
      "name": "release-arm64",
      "displayName": "Release (cross-compiled for ARM64)",
      "inherits": [
        "release",
        "arm64"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "perf",
      "configurePreset": "perf"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "dev-arm64",
      "configurePreset": "dev-arm64"
    },
    {
      "name": "release-arm64",
      "configurePreset": "release-arm64"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "functional",
      "hidden": true,
      "inherits": "base",
      "filter": {
        "exclude": {
          "label": "perf|root"
        }
      }
    },
    {
      "name": "dev",
      "inherits": "functional",
      "configurePreset": "dev"
    },
    {
      "name": "unit",
      "inherits": "base",
      "configurePreset": "dev",
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    },
    {
      "name": "integration",
      "inherits": "base",
      "configurePreset": "dev",
      "filter": {
        "include": {
          "label": "integration"
        }
      }
    },
    {
      "name": "root",
      "displayName": "Tests that must run as root (dev build): sudo ctest --preset root",
      "inherits": "base",
      "configurePreset": "dev",
      "filter": {
        "include": {
          "label": "root"
        }
      }
    },
    {
      "name": "release",
      "inherits": "functional",
      "configurePreset": "release"
    },
    {
      "name": "perf",
      "inherits": "base",
      "configurePreset": "perf",
      "filter": {
        "include": {
          "label": "perf"
        }
      }
    },
    {
      "name": "asan-ubsan",
      "inherits": "functional",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "tsan",
      "inherits": "functional",
      "configurePreset": "tsan"
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "configurePreset": "fuzz",
      "filter": {
        "include": {
          "label": "fuzz"
        }
      }
    },
    {
      "name": "dev-arm64",
      "inherits": "functional",
      "configurePreset": "dev-arm64"
    },
    {
      "name": "release-arm64",
      "inherits": "functional",
      "configurePreset": "release-arm64"
    }
  ]
}
