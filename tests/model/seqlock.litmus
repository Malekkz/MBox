AArch64 seqlock
"Sequence lock of a tag record, contract 0.5 sections 6.1, 6.2 and 7"
(*
 * P0 is the owner thread: two calls of write_string_record
 * (libs/scada-tag/src/tag_record.cpp), each `begin_write`, the string slot,
 * the record fields, `end_write`. P1 is one attempt of read_string_record:
 * the acquire load of seq, the copy of the fields and of the slot,
 * `fence_acquire`, the second load of seq.
 *
 * Three locations stand for every field: q (quality and flags), v (value
 * and times) and s (the string slot). The first write stores 1 in each, the
 * second 2. write_record is the same without s.
 *
 * fence_release compiles to DMB ISH, fence_acquire to DMB ISHLD, the
 * release store of end_write to STLR, the acquire load of a read to LDAR
 * (GCC and Clang, -O2). tests/model/code_shape.py checks that the library
 * still compiles to this order.
 *
 * The condition is a read that the library accepts (two equal, even loads
 * of seq) and whose copy is not the one write that the number names:
 * seq 0 has all fields 0, seq 2 all 1, seq 4 all 2.
 *)
{
0:X0=seq; 0:X1=q; 0:X2=v; 0:X3=s;
1:X0=seq; 1:X1=q; 1:X2=v; 1:X3=s;
}
 P0             | P1             ;
 LDR W4,[X0]    | LDAR W4,[X0]   ;
 ADD W5,W4,#1   | LDR W5,[X1]    ;
 STR W5,[X0]    | LDR W6,[X2]    ;
 DMB ISH        | LDR W7,[X3]    ;
 MOV W6,#1      | DMB ISHLD      ;
 STR W6,[X3]    | LDR W8,[X0]    ;
 STR W6,[X1]    |                ;
 STR W6,[X2]    |                ;
 ADD W7,W4,#2   |                ;
 STLR W7,[X0]   |                ;
 LDR W8,[X0]    |                ;
 ADD W9,W8,#1   |                ;
 STR W9,[X0]    |                ;
 DMB ISH        |                ;
 MOV W10,#2     |                ;
 STR W10,[X3]   |                ;
 STR W10,[X1]   |                ;
 STR W10,[X2]   |                ;
 ADD W11,W8,#2  |                ;
 STLR W11,[X0]  |                ;
exists
( (1:X4=0 /\ 1:X8=0 /\ ~(1:X5=0 /\ 1:X6=0 /\ 1:X7=0))
\/ (1:X4=2 /\ 1:X8=2 /\ ~(1:X5=1 /\ 1:X6=1 /\ 1:X7=1))
\/ (1:X4=4 /\ 1:X8=4 /\ ~(1:X5=2 /\ 1:X6=2 /\ 1:X7=2)) )
