{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tags.schema.json",
  "title": "tags/*.yaml (configuration schemas contract, section 5.1)",
  "type": "object",
  "properties": {
    "tags": { "type": "array", "items": { "$ref": "#/$defs/tag" } }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "tag": {
      "type": "object",
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/tag_name" },
        "type": { "type": "string", "enum": ["internal", "manual", "virtual"] },
        "value_type": { "description": "Required for internal and manual; derived from expr for virtual", "type": "string", "enum": ["bool", "int64", "uint64", "float64", "string"] },
        "kind": { "description": "Default plain", "type": "string", "enum": ["plain", "counter"] },
        "description": { "$ref": "common.schema.json#/$defs/text" },
        "unit": { "description": "At most 32 bytes", "type": "string", "x-scada-type": "text", "x-scada-max": 32 },
        "range": { "description": "[min, max] in engineering units", "$ref": "point.schema.json#/$defs/range" },
        "enum": { "$ref": "point.schema.json#/$defs/enumeration_or_reference" },
        "area": { "description": "Required for manual", "$ref": "common.schema.json#/$defs/identifier" },
        "alarms": { "$ref": "point.schema.json#/$defs/alarms" },
        "logging": { "$ref": "point.schema.json#/$defs/logging" },
        "retain": { "description": "Default true for manual, else false", "$ref": "point.schema.json#/$defs/boolean" },
        "retain_now": { "description": "internal and manual only; needs retain. Default false", "$ref": "point.schema.json#/$defs/boolean" },
        "retain_max_age": { "type": "string", "x-scada-type": "duration", "x-scada-min": "1s", "x-scada-max": "3650d" },
        "task": { "description": "internal and virtual only. Default for virtual: normal", "$ref": "common.schema.json#/$defs/identifier" },
        "expr": { "description": "virtual only, required", "type": "string", "x-scada-type": "expression" },
        "quality": { "description": "virtual only. Default worst", "type": "string", "enum": ["worst", "ignore_bad"] },
        "limits": {
          "description": "manual only: { min, max } in engineering units",
          "type": "object",
          "properties": {
            "min": { "$ref": "point.schema.json#/$defs/number" },
            "max": { "$ref": "point.schema.json#/$defs/number" }
          },
          "unevaluatedProperties": false
        },
        "initial": { "description": "manual and internal only: the value when none is restored. Default none: BAD, NOT_INIT until written", "type": ["number", "boolean", "string"], "x-scada-type": "string" }
      },
      "required": ["name", "type"],
      "unevaluatedProperties": false
    }
  }
}
