{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system.schema.json",
  "title": "system.yaml (configuration schemas contract, section 3)",
  "type": "object",
  "properties": {
    "format": { "description": "Tree format. Default 1", "type": "integer", "x-scada-type": "integer" },
    "unit": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "x-scada-type": "unit_id" },
        "name": { "type": "string", "x-scada-type": "text", "x-scada-min": 1, "x-scada-max": 64 }
      },
      "required": ["id", "name"],
      "unevaluatedProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "role": { "description": "Default standalone",
          "type": "string",
          "enum": ["standalone", "master", "slave"],
          "x-scada-reserved-values": ["master", "slave"]
        }
      },
      "unevaluatedProperties": false
    },
    "time": {
      "type": "object",
      "properties": {
        "timezone": { "type": "string", "x-scada-type": "time_zone" },
        "sync": {
          "type": "object",
          "properties": {
            "mode": { "description": "Default ntp", "type": "string", "enum": ["ntp", "ptp", "none"] },
            "servers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "type": "string", "x-scada-type": "host" }
            },
            "alarm_offset_ms": { "description": "In ms. Default 500", "type": "integer", "x-scada-type": "integer", "minimum": 1, "maximum": 60000 },
            "alarm_unsynced_s": { "description": "In s. Default 600", "type": "integer", "x-scada-type": "integer", "minimum": 10, "maximum": 86400 }
          },
          "unevaluatedProperties": false
        }
      },
      "required": ["timezone"],
      "unevaluatedProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "hostname": { "description": "Default the unit id", "type": "string", "x-scada-type": "host_name" },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "x-scada-type": "text", "x-scada-min": 1, "x-scada-max": 15 },
              "zone": { "type": "string", "enum": ["field", "management"] },
              "addresses": { "type": "array", "items": { "type": "string", "x-scada-type": "cidr" } },
              "gateway": { "type": "string", "x-scada-type": "ip_address" },
              "dns": { "type": "array", "items": { "type": "string", "x-scada-type": "ip_address" } }
            },
            "required": ["name"],
            "unevaluatedProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "free_space_alarm": { "description": "Default 10%", "type": "string", "x-scada-type": "percentage", "minimum": 0, "maximum": 100 },
        "journal_reserve": { "description": "Default 2GiB", "type": "string", "x-scada-type": "size" }
      },
      "unevaluatedProperties": false
    },
    "conf": {
      "type": "object",
      "properties": {
        "keep_versions": { "description": "Default 50", "type": "integer", "x-scada-type": "integer", "minimum": 5, "maximum": 1000 }
      },
      "unevaluatedProperties": false
    },
    "upstream": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "x-scada-type": "https_url" },
        "auth": {
          "type": "object",
          "properties": {
            "certificate": { "x-scada-secret": true },
            "token": { "x-scada-secret": true }
          },
          "x-scada-exclusive": [["certificate", "token"]],
          "unevaluatedProperties": false
        },
        "order": { "description": "Default newest_first", "type": "string", "enum": ["newest_first", "oldest_first"] },
        "rate_limit": { "description": "Per second", "type": "string", "x-scada-type": "size" },
        "window": {
          "type": "object",
          "properties": {
            "from": { "type": "string", "x-scada-type": "time_of_day" },
            "to": { "type": "string", "x-scada-type": "time_of_day" }
          },
          "required": ["from", "to"],
          "unevaluatedProperties": false
        }
      },
      "required": ["url"],
      "unevaluatedProperties": false
    },
    "email": {
      "type": "object",
      "properties": {
        "server": { "type": "string", "x-scada-type": "host" },
        "port": { "description": "Default 587", "type": "integer", "x-scada-type": "integer", "minimum": 1, "maximum": 65535 },
        "tls": { "description": "Default starttls", "type": "string", "enum": ["starttls", "implicit"] },
        "username": { "$ref": "common.schema.json#/$defs/text" },
        "password": { "x-scada-secret": true },
        "from": { "$ref": "common.schema.json#/$defs/text" }
      },
      "required": ["server", "from"],
      "unevaluatedProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_tags": { "description": "Default 50000", "type": "integer", "x-scada-type": "integer", "minimum": 1, "maximum": 1000000 },
        "max_devices": { "description": "Default 1000", "type": "integer", "x-scada-type": "integer", "minimum": 1, "maximum": 10000 },
        "max_devices_per_channel": { "description": "Default 247", "type": "integer", "x-scada-type": "integer", "minimum": 1, "maximum": 256 },
        "max_channels": { "description": "Default 300", "type": "integer", "x-scada-type": "integer", "minimum": 1, "maximum": 1000 }
      },
      "unevaluatedProperties": false
    },
    "data_plane": {
      "type": "object",
      "properties": {
        "heartbeat_check_ms": { "description": "In ms. Default 250", "type": "integer", "x-scada-type": "integer", "minimum": 1, "maximum": 60000 },
        "retain_interval_ms": { "description": "In ms. Default 5000", "type": "integer", "x-scada-type": "integer", "minimum": 1000, "maximum": 60000 },
        "generation_change_limit": { "description": "Default 5s", "type": "string", "x-scada-type": "duration", "x-scada-min": "1s", "x-scada-max": "60s" },
        "processes": {
          "type": "object",
          "x-scada-key-type": "process_name",
          "unevaluatedProperties": {
            "type": "object",
            "properties": {
              "heartbeat_timeout_ms": { "description": "In ms. Default 3000; 500 for a real-time process", "type": "integer", "x-scada-type": "integer", "minimum": 1, "maximum": 600000 },
              "control_attach_grace": { "description": "Default 60s", "type": "string", "x-scada-type": "duration", "x-scada-min": "0s", "x-scada-max": "600s" }
            },
            "unevaluatedProperties": false
          }
        },
        "event_queue_capacity": { "description": "Default 1024", "type": "integer", "x-scada-type": "power_of_two", "minimum": 16, "maximum": 1048576 },
        "command_queue_capacity": { "description": "Default 1024", "type": "integer", "x-scada-type": "power_of_two", "minimum": 16, "maximum": 1048576 }
      },
      "unevaluatedProperties": false
    },
    "realtime": {
      "type": "object",
      "properties": {
        "cpus": {
          "type": "array",
          "items": { "type": "integer", "x-scada-type": "integer", "minimum": 0, "maximum": 4095 }
        },
        "io_priority": { "description": "Default 95", "type": "integer", "x-scada-type": "integer", "minimum": 2, "maximum": 98 }
      },
      "unevaluatedProperties": false
    }
  },
  "required": ["unit", "time"],
  "unevaluatedProperties": false
}
