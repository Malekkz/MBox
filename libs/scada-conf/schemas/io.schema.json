{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io.schema.json",
  "title": "The io protocol schema of scada-io (configuration schemas contract, Annex B)",
  "$defs": {
    "address": {
      "description": "Annex B.2, and the simulator's profile (B.3)",
      "type": "object",
      "properties": {
        "line": {
          "description": "The line by its name, or its offset on the chip; required for gpio",
          "oneOf": [
            { "type": "integer", "x-scada-type": "integer", "minimum": 0, "maximum": 1023 },
            { "type": "string", "x-scada-type": "text" }
          ]
        },
        "direction": { "description": "Required for gpio", "type": "string", "enum": ["input", "output"] },
        "active_low": { "description": "Default false", "$ref": "point.schema.json#/$defs/boolean" },
        "bias": { "description": "Default none", "type": "string", "enum": ["none", "pull_up", "pull_down"] },
        "debounce": { "description": "Default 0ms", "type": "string", "x-scada-type": "duration", "x-scada-min": "0ms", "x-scada-max": "1s" },
        "at_start": { "description": "No default: required for an output", "type": "string", "enum": ["hold", "safe"] },
        "channel": { "description": "The IIO channel by its name; required for iio", "type": "string", "x-scada-type": "text" },
        "filter": { "description": "First-order filter time constant. Default 0ms", "type": "string", "x-scada-type": "duration", "x-scada-min": "0ms", "x-scada-max": "60s" },
        "clamp": { "description": "[min, max] in engineering units, after scaling", "$ref": "point.schema.json#/$defs/range" },
        "profile": {
          "description": "The simulator's profile of the point and its parameters",
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["constant", "ramp", "sine", "square", "random"] },
            "replace": { "$ref": "point.schema.json#/$defs/replace" }
          },
          "x-scada-key-type": "identifier",
          "unevaluatedProperties": { "type": ["number", "string", "boolean"], "x-scada-type": "string" }
        },
        "replace": { "$ref": "point.schema.json#/$defs/replace" }
      },
      "unevaluatedProperties": false
    },
    "point": { "properties": { "address": { "$ref": "#/$defs/address" } } },
    "points": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "defaults": {
      "description": "io has no raw types: the raw-type map of invalid_values names none (section 4.7)",
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "invalid_values": {
          "oneOf": [
            { "type": "array" },
            {
              "type": "object",
              "properties": { "replace": { "$ref": "point.schema.json#/$defs/replace" } },
              "unevaluatedProperties": false
            }
          ]
        }
      }
    },
    "addresses_of_points": {
      "properties": {
        "points": { "$ref": "#/$defs/points" },
        "defaults": { "$ref": "#/$defs/defaults" },
        "overrides": { "type": "object", "unevaluatedProperties": { "$ref": "#/$defs/point" } },
        "repeat": { "type": "array", "items": { "properties": { "points": { "$ref": "#/$defs/points" } } } },
        "identify": { "type": "array", "items": { "properties": { "address": { "$ref": "#/$defs/address" } } } }
      }
    },
    "template": {
      "allOf": [{ "$ref": "template.schema.json#/$defs/template_keys" }, { "$ref": "#/$defs/addresses_of_points" }],
      "unevaluatedProperties": false
    },
    "channel": {
      "allOf": [{ "$ref": "channel.schema.json#/$defs/channel" }],
      "properties": {
        "backend": { "type": "string", "enum": ["simulator", "gpio", "iio"] },
        "chip": { "description": "The GPIO chip by its label; required for gpio", "type": "string", "x-scada-type": "text" },
        "device": { "description": "The IIO device by its name; required for iio", "type": "string", "x-scada-type": "text" },
        "scan": { "description": "Default auto", "type": "string", "enum": ["auto", "every_cycle", "helper"] }
      },
      "required": ["backend"],
      "unevaluatedProperties": false
    },
    "device": {
      "allOf": [{ "$ref": "channel.schema.json#/$defs/device" }, { "$ref": "#/$defs/addresses_of_points" }],
      "unevaluatedProperties": false
    },
    "channel_file": {
      "type": "object",
      "properties": {
        "channel": { "$ref": "#/$defs/channel" },
        "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } }
      },
      "required": ["channel"],
      "unevaluatedProperties": false
    }
  }
}
