{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alarms.schema.json",
  "title": "alarms/*.yaml (configuration schemas contract, section 8)",
  "type": "object",
  "properties": {
    "priorities": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
    "max_shelve": {
      "type": "object",
      "x-scada-key-type": "identifier",
      "unevaluatedProperties": { "type": "string", "x-scada-type": "duration", "x-scada-min": "1ms" }
    },
    "classes": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
    "alarms": { "$ref": "point.schema.json#/$defs/alarms" }
  },
  "unevaluatedProperties": false
}
