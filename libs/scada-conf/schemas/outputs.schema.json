{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outputs.schema.json",
  "title": "outputs/*.yaml: outputs and interlocks (configuration schemas contract, sections 7.2 to 7.4)",
  "type": "object",
  "properties": {
    "interlocks": { "type": "array", "items": { "$ref": "#/$defs/interlock" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/output" } }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "tag": { "$ref": "common.schema.json#/$defs/tag_name" },
    "tag_list": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/tag_name" } },
    "value_or_raw": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "value": { "type": ["number", "boolean"], "x-scada-type": "number_or_boolean" } },
          "required": ["value"],
          "unevaluatedProperties": false
        },
        {
          "type": "object",
          "properties": { "raw": { "type": ["integer", "string"], "x-scada-type": "raw_pattern" } },
          "required": ["raw"],
          "unevaluatedProperties": false
        }
      ]
    },
    "interlock": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/tag" },
        "condition": { "type": "string", "x-scada-type": "expression" },
        "message": { "$ref": "common.schema.json#/$defs/text" },
        "task": { "$ref": "common.schema.json#/$defs/identifier" }
      },
      "required": ["name", "condition", "message"],
      "unevaluatedProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/tag" },
        "area": { "$ref": "common.schema.json#/$defs/identifier" },
        "kind": {
          "type": "string",
          "enum": ["single", "double", "pulse", "step", "setpoint", "trigger", "latch"],
          "x-scada-reserved-values": ["latch"]
        },
        "on_only": { "$ref": "point.schema.json#/$defs/boolean" },
        "target": { "$ref": "#/$defs/tag" },
        "feedback": {
          "oneOf": [
            { "$ref": "#/$defs/tag" },
            {
              "type": "object",
              "properties": { "on": { "$ref": "#/$defs/tag" }, "off": { "$ref": "#/$defs/tag" } },
              "required": ["on", "off"],
              "unevaluatedProperties": false
            },
            {
              "type": "object",
              "properties": {
                "tag": { "$ref": "#/$defs/tag" },
                "within": { "$ref": "point.schema.json#/$defs/number" },
                "settle": { "type": "string", "x-scada-type": "duration", "x-scada-min": "0s" }
              },
              "required": ["tag", "within", "settle"],
              "unevaluatedProperties": false
            }
          ]
        },
        "no_feedback": { "type": "boolean", "x-scada-type": "boolean", "enum": ["true"] },
        "feedback_timeout": { "type": "string", "x-scada-type": "duration", "x-scada-min": "100ms", "x-scada-max": "10m" },
        "sbo": { "$ref": "point.schema.json#/$defs/boolean" },
        "select_timeout": { "type": "string", "x-scada-type": "duration", "x-scada-min": "1s", "x-scada-max": "60s" },
        "native_select": { "type": "string", "enum": ["at_select", "at_operate"] },
        "reason_required": { "$ref": "point.schema.json#/$defs/boolean" },
        "reauth": { "$ref": "point.schema.json#/$defs/boolean" },
        "limits": {
          "type": "object",
          "properties": {
            "min": { "$ref": "point.schema.json#/$defs/number" },
            "max": { "$ref": "point.schema.json#/$defs/number" },
            "ranges": { "type": "array", "minItems": 1, "items": { "$ref": "point.schema.json#/$defs/range" } },
            "rate": { "$ref": "point.schema.json#/$defs/number" },
            "release": { "$ref": "#/$defs/value_or_raw" }
          },
          "unevaluatedProperties": false
        },
        "interlocks": {
          "oneOf": [
            { "$ref": "#/$defs/tag_list" },
            {
              "type": "object",
              "properties": { "on": { "$ref": "#/$defs/tag_list" }, "off": { "$ref": "#/$defs/tag_list" } },
              "required": ["on", "off"],
              "unevaluatedProperties": false
            }
          ]
        },
        "refresh": { "type": "string", "x-scada-type": "duration", "x-scada-min": "1s", "x-scada-max": "1d" },
        "auto_deadband": { "$ref": "point.schema.json#/$defs/number" },
        "safe_state": {
          "oneOf": [
            { "type": "string", "enum": ["off", "on", "hold"] },
            { "$ref": "#/$defs/value_or_raw" }
          ]
        },
        "failsafe_retry": { "type": "string", "x-scada-type": "duration", "x-scada-min": "1s", "x-scada-max": "60s" },
        "failsafe_max_refusals": { "type": "integer", "x-scada-type": "integer", "minimum": 1, "maximum": 10 },
        "on_shutdown": { "type": "string", "enum": ["hold", "safe", "release"] },
        "on_control_loss": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "enum": ["hold", "safe", "release"] },
            "after": { "type": "string", "x-scada-type": "duration", "x-scada-min": "0s", "x-scada-max": "10m" }
          },
          "required": ["action"],
          "unevaluatedProperties": false
        },
        "on_generation_change": { "type": "string", "enum": ["hold", "safe"] },
        "task": { "$ref": "common.schema.json#/$defs/identifier" },
        "duration": { "type": "string", "x-scada-type": "duration", "x-scada-min": "0s" },
        "termination_timeout": { "x-scada-reserved": true }
      },
      "required": ["name", "area", "kind", "target"],
      "x-scada-exclusive": [["feedback", "no_feedback"]],
      "unevaluatedProperties": false
    }
  }
}
